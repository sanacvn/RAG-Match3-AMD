# Copy to .env. The worker and CLI read it without executing shell code.
# Local Transformers for answers/vision; Chroma Cloud API for retrieval/embeddings.
RAG_BACKEND=transformers
RAG_SEARCH_BACKEND=chroma
RAG_CONFIG=configs/chroma.json
# Chroma Cloud retrieval + hosted Qwen dense/SPLADE sparse embeddings.
# The local PyTorch generator and vision model are still required.
CHROMA_HOST=api.trychroma.com
CHROMA_TENANT=11afbef7-38c1-4590-93de-3dc5dc9851f9
CHROMA_DATABASE=RAG-MATCH3-AMD
CHROMA_SCOPE=aliaatikah12
# Put your Chroma key here locally; never commit it or paste it into chat.
CHROMA_API_KEY=
# Optional stable, unique corpus ID when moving a corpus between machines.
# RAG_CORPUS_ID=
CHROMA_BATCH_SIZE=64
CHROMA_CHUNK_BYTES=12288
CHROMA_CHUNKS_PER_DOCUMENT=3
# Offline alternative: RAG_SEARCH_BACKEND=local, RAG_CONFIG=configs/E0.json.
RAG_SOCKET=/tmp/match3-rag.sock
RAG_STATE_DIR=state
RAG_OUTPUT_DIR=output
RAG_MODEL_DIR=models
# Required for transformers; paths below default to RAG_MODEL_DIR/<role>.
# RAG_GENERATOR_PATH=models/generator
# RAG_EMBEDDING_PATH=models/embedding  # Only used with RAG_SEARCH_BACKEND=local.
# RAG_VISION_PATH=models/vision
# RAG_RERANKER_PATH=models/reranker
# Required for submission, but does not establish ROCm compatibility by itself.
RAG_DEVICE=cuda
RAG_REQUIRE_ROCM=true
RAG_VERIFY_WEIGHTS=true
# Optional deadlines with margins below the official hard limits.
RAG_QUERY_TIMEOUT=26
RAG_STARTUP_TIMEOUT=570
RAG_PARSE_TIMEOUT=15
RAG_MAX_FILE_MB=100
RAG_MAX_NEW_TOKENS=512
# Diagnostic text-only backend: RAG_BACKEND=extractive, RAG_DEVICE=cpu,
# RAG_REQUIRE_ROCM=false, RAG_SEARCH_BACKEND=local, RAG_CONFIG=configs/E0.json.
# It cannot read images and is not a submission backend.
# Download-time only; optional for public, ungated models. Never commit a real token.
# HF_TOKEN=
